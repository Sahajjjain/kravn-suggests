# 1) Copy this file and rename the copy to:  secrets.properties   (same folder as pom.xml)
# 2) Paste your keys after the = signs. No quotes, no spaces.

# REQUIRED. TMDB "API Read Access Token" (the long one starting with eyJ...)
tmdb.token=

# OPTIONAL. Anthropic key. Without it the app still works and estimates match % from genres.
anthropic.api-key=
